{
  "name": "circuitbreaker-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.ts --bundle --outfile=public/bundle.js --format=iife --target=es2022 --minify",
    "dev": "esbuild src/app.ts --bundle --outfile=public/bundle.js --format=iife --target=es2022 --servedir=public --watch=forever",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
